# Fresh Ubuntu VPS only. Changing this on an existing sing-box installation
# is not a migration; the installer will refuse to replace it.
DEPLOYMENT_MODE=remnawave

# DNS-only A record pointing directly to this VPS, without CDN proxying.
# The panel uses this domain. Both domains share PANEL_HTTPS_PORT.
PANEL_DOMAIN=panel.example.com
PANEL_HTTPS_PORT=8443
# Optional separate hostname for personal subscriptions, e.g. sub.example.com.
# Empty reuses PANEL_DOMAIN. Needs its own DNS-only A record to the same VPS.
# Choose before initial installation; changing installed domains is not automated.
SUBSCRIPTION_DOMAIN=
LETSENCRYPT_EMAIL=admin@example.com

# Both protocols appear in each user's subscription through the VPN Users squad.
ENABLE_VLESS=true
ENABLE_HYSTERIA=true
VLESS_PORT=443
HYSTERIA_PORT=443

# Select a suitable external TLS target reachable from your VPS.
REALITY_SERVER_NAME=
REALITY_HANDSHAKE_PORT=443
REALITY_FINGERPRINT=chrome
# Xray's default admits Xray 26.3.27+. Hiddify/sing-box advertises Reality 1.8.1.
# Set 1.8.1 for compatibility only if you accept Xray's warning about increased
# detection/IP-blocking risk. For existing installs, edit minClientVer in the panel.
REALITY_MIN_CLIENT_VERSION=26.3.27

# Empty HYSTERIA_DOMAIN reuses PANEL_DOMAIN and its certificate.
HYSTERIA_DOMAIN=
HYSTERIA_MASQUERADE_URL=
HYSTERIA_OBFS_TYPE=
HYSTERIA_UP_MBPS=100
HYSTERIA_DOWN_MBPS=100

# Set explicitly behind cloud NAT. Otherwise detect the public route address.
SERVER_IPV4=

# Manages host TCP/80 for ACME. Docker publishes VPN and HTTPS ports itself;
# UFW does not filter Docker-published ports. Use the provider firewall for
# source-IP restrictions. No Node API, database or cache port is published.
FIREWALL_BACKEND=auto

# Loopback-only API port for bootstrap and maintenance (not public).
REMNAWAVE_API_PORT=3000

# Test certificates are not trusted by normal clients. Use only for testing.
CERTBOT_STAGING=false
