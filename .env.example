# standalone (sing-box) or remnawave (panel + local Xray node).
# For Remnawave, start with .env.remnawave.example instead.
DEPLOYMENT_MODE=standalone

# Enable or disable each protocol independently. At least one must be true.
ENABLE_VLESS=true
ENABLE_HYSTERIA=true

# Domain for Hysteria2. Required only when ENABLE_HYSTERIA=true.
# It must already resolve via an A record to this VPS.
HYSTERIA_DOMAIN=edge.example.com

# Email used by Let's Encrypt for certificate issuance.
# Required only when ENABLE_HYSTERIA=true.
LETSENCRYPT_EMAIL=admin@example.com

# HTTP/3 reverse-proxy target shown to unauthenticated Hysteria2 clients.
# Required only when ENABLE_HYSTERIA=true. Prefer a stable benign site you
# control, and do not point it back to this proxy endpoint.
HYSTERIA_MASQUERADE_URL=

# Optional Hysteria2 QUIC obfuscation: blank, salamander, or gecko.
# Leave blank to retain ordinary HTTP/3-looking traffic. Gecko requires
# sing-box 1.14.0-alpha.26 or newer and is experimental until 1.14 is stable.
HYSTERIA_OBFS_TYPE=

# SNI/handshake target used by VLESS Reality.
# Required only when ENABLE_VLESS=true. Choose it explicitly for this VPS.
REALITY_SERVER_NAME=

# Reality handshake port.
REALITY_HANDSHAKE_PORT=443

# Client-side uTLS fingerprint hint. Choose one supported by the client.
# This is a compatibility setting, not a guarantee against fingerprinting.
REALITY_FINGERPRINT=chrome

# TCP port for VLESS Reality. Used only when ENABLE_VLESS=true.
VLESS_PORT=443

# UDP port for Hysteria2. Used only when ENABLE_HYSTERIA=true.
HYSTERIA_PORT=443

# User label stored in the Hysteria2 inbound.
HYSTERIA_USER=user1

# Bandwidth limits for Hysteria2 in Mbps.
HYSTERIA_UP_MBPS=100
HYSTERIA_DOWN_MBPS=100

# Leave empty to auto-detect the server public IPv4 and default route interface.
SERVER_IPV4=
PRIMARY_INTERFACE=

# Firewall backend: auto, ufw, iptables, none.
FIREWALL_BACKEND=auto

# Enable managed IPv4 NAT.
MANAGE_NAT=true

# Use Let's Encrypt staging while testing to avoid production rate limits.
CERTBOT_STAGING=false

# Official package name from the SagerNet repository. Use sing-box-beta only
# when explicitly testing features such as Gecko that are not stable yet.
SING_BOX_PACKAGE=sing-box

# Optional pre-generated secrets. Leave blank to generate them on first install.
# Blank values are reused from /etc/sing-box/bootstrap.env on subsequent runs.
# VLESS_* and REALITY_* are used only when ENABLE_VLESS=true.
# HYSTERIA_PASSWORD and HYSTERIA_OBFS_PASSWORD are used only when
# ENABLE_HYSTERIA=true. The obfs password is generated only when obfs is set.
VLESS_UUID=
REALITY_PRIVATE_KEY=
REALITY_PUBLIC_KEY=
REALITY_SHORT_ID=
HYSTERIA_PASSWORD=
HYSTERIA_OBFS_PASSWORD=
