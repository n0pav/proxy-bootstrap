# 2S-UI panel with embedded sing-box; use on a clean Ubuntu VPS.
DEPLOYMENT_MODE=2s-ui

# DNS-only A records, no CDN proxy or AAAA records. Choose before installation.
PANEL_DOMAIN=panel.example.com
PANEL_HTTPS_PORT=8443
# Optional: sub.example.com; empty reuses PANEL_DOMAIN and the same HTTPS port.
SUBSCRIPTION_DOMAIN=
LETSENCRYPT_EMAIL=admin@example.com
# Required behind cloud NAT; otherwise auto-detected from the public interface.
SERVER_IPV4=

ENABLE_VLESS=true
ENABLE_HYSTERIA=true
VLESS_PORT=443
HYSTERIA_PORT=443

# Choose a reachable TLS 1.3 site for the Reality handshake.
REALITY_SERVER_NAME=
REALITY_HANDSHAKE_PORT=443
REALITY_FINGERPRINT=chrome

# Empty reuses the panel domain and its certificate.
HYSTERIA_DOMAIN=
HYSTERIA_UP_MBPS=100
HYSTERIA_DOWN_MBPS=100
HYSTERIA_MASQUERADE_URL=
# Empty or salamander. The installer generates the shared obfuscation secret.
HYSTERIA_OBFS_TYPE=

# Loopback-only maintenance API. Container listeners stay on 2095/2096.
TWOSUI_API_PORT=2095
FIREWALL_BACKEND=auto
# Tests only: staging certificates are not trusted by regular clients.
CERTBOT_STAGING=false
